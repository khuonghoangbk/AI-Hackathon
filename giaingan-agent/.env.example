# GreenNode MaaS (OpenAI-compatible) — KHÔNG commit file .env thật
GREENNODE_API_BASE=https://<maas-endpoint>/v1
GREENNODE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Model theo use case
MODEL_REASONING=glm-5.2
MODEL_FAST=qwen-flash-3.6

# Client cho AgentBase deploy (BTC cấp)
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# Chế độ chạy: mock = không gọi LLM thật (demo luồng); live = gọi MaaS
RUN_MODE=mock
