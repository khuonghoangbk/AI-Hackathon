# GreenNode MaaS (OpenAI-compatible endpoint) — KHÔNG commit .env thật
GREENNODE_API_BASE=https://<maas-endpoint>/v1
GREENNODE_API_KEY=sk-xxxxxxxxxxxxxxxx

# Model theo use case (đổi model chỉ bằng 1 dòng)
MODEL_REASONING=glm-5.2
MODEL_FAST=qwen-flash-3.6

# Ngưỡng dung sai làm tròn số tiền (VND)
TOLERANCE_VND=1000

# Đường dẫn dữ liệu mock (mặc định trỏ vào data_mock/)
DATA_MOCK_DIR=data_mock
CONFIG_DIR=config
